# Serveurs web cibles du TP Apache
[apache_servers]
web-ubuntu ansible_host=<IP_PUBLIQUE> ansible_user=ubuntu   ansible_python_interpreter=/usr/bin/python3
web-centos ansible_host=<IP_PUBLIQUE>    ansible_user=ec2-user ansible_python_interpreter=/usr/bin/python3

[apache_servers:vars]
ansible_ssh_private_key_file=~/.ssh/at-pairkey-khalid-akorutam.pem